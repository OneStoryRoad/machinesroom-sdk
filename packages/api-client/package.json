{
  "name": "@machinesroom/api-client",
  "version": "0.1.6",
  "description": "The Machines Room public API client and Node-first Agent SDK.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "homepage": "https://machinesroom.com/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneStoryRoad/MachinesRoom.git",
    "directory": "packages/api-client"
  },
  "bugs": {
    "url": "https://github.com/OneStoryRoad/MachinesRoom/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./gate-one-policy": {
      "types": "./dist/generated/gate-one-policy.generated.d.ts",
      "import": "./dist/generated/gate-one-policy.generated.js"
    },
    "./gate-one-proof-graph": {
      "types": "./dist/generated/gate-one-proof-graph.generated.d.ts",
      "import": "./dist/generated/gate-one-proof-graph.generated.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @machinesroom/contracts build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @machinesroom/contracts build",
    "typecheck": "tsc --noEmit",
    "prelint": "pnpm --filter @machinesroom/contracts build",
    "lint": "pnpm run typecheck",
    "pretest": "pnpm --filter @machinesroom/contracts build",
    "test": "tsx --test tests/index.test.ts",
    "prepack": "pnpm run build",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@machinesroom/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  }
}
