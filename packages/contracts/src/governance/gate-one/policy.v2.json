  "verdicts": [
    {
      "id": "PASS",
      "countsTowardPass": true,
      "requiresDisclosureReceipt": false,
      "blocksPublication": false,
      "hardVeto": false,
      "summary": "Rubric is satisfied with no additional required disclosure."
    },
    {
      "id": "PASS_WITH_DISCLOSURE",
      "countsTowardPass": true,
      "requiresDisclosureReceipt": true,
      "blocksPublication": false,
      "hardVeto": false,
