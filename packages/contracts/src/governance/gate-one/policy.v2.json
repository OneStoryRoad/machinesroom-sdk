  "preflights": [
    {
      "id": "PACKET_INTEGRITY_V1",
      "version": "1.0.0",
      "state": "ENFORCE",
      "owner": "Trust Platform",
      "failureBehavior": "FAIL_CLOSED",
      "summary": "Validates packet schema, canonical hash, stable IDs, references, public/sealed separation, signed-write admission, and bounded input size.",
      "checks": [
        { "id": "PKT.SCHEMA_VERSION_SUPPORTED", "label": "Schema version is supported" },
        { "id": "PKT.POLICY_REFERENCES_PRESENT", "label": "Policy and rubric references exist" },
        { "id": "PKT.HASH_RECOMPUTES", "label": "Packet hash recomputes exactly" },
        { "id": "PKT.STABLE_IDS_UNIQUE", "label": "Stable IDs are unique" },
        { "id": "PKT.MATERIAL_CLAIMS_HAVE_EVIDENCE", "label": "Material factual claims link to evidence" },
        { "id": "PKT.PUBLIC_SEALED_SPLIT", "label": "Public envelope contains no sealed fields" },
        { "id": "PKT.SIGNED_WRITE_CONTEXT_VALID", "label": "Signed-write admission context is valid" },
        { "id": "PKT.SIZE_AND_DEPTH_BOUNDS", "label": "Packet size and JSON depth are bounded" }
      ]
    },
    {
      "id": "PUBLICATION_QA_V1",
      "version": "1.0.0",
      "state": "ENFORCE",
      "owner": "Trust Platform",
      "failureBehavior": "FAIL_CLOSED",
      "summary": "Checks deterministic publication structure, labels, accessibility, localization shape, links, render slots, and correction hooks.",
      "checks": [
        { "id": "QA.ARTICLE_TYPE_LABEL", "label": "Article type label is valid" },
        { "id": "QA.REQUIRED_SLOTS_PRESENT", "label": "Required title, body, methods, and disclosure slots exist" },
        { "id": "QA.ACCESSIBILITY_MEDIA", "label": "Material media has alt text, captions, or transcript" },
        { "id": "QA.CLAIM_CITATION_ANCHORS", "label": "Claim and citation anchors resolve" },
        { "id": "QA.SSRF_SAFE_LINKS", "label": "External link checks use SSRF-safe infrastructure" },
        { "id": "QA.TRANSLATION_PARITY", "label": "Translation parity is preserved" },
        { "id": "QA.CORRECTION_HOOKS", "label": "Correction and challenge hooks are present" }
      ]
    },
    {
      "id": "RIGHTS_ROUTING_V1",
      "version": "1.0.0",
      "state": "ENFORCE",
      "owner": "Trust Platform",
      "failureBehavior": "FAIL_CLOSED",
      "summary": "Classifies rights-sensitive content and deterministically routes legal/rights review, holds, remediation, or disclosures without claiming legal clearance.",
      "checks": [
        { "id": "RIGHTS.SERIOUS_ALLEGATION", "label": "Serious allegation trigger is classified" },
        { "id": "RIGHTS.PRIVATE_OR_VULNERABLE_PERSON", "label": "Private, minor, or vulnerable person trigger is classified" },
        { "id": "RIGHTS.SENSITIVE_PERSONAL_INFO", "label": "Sensitive personal information trigger is classified" },
        { "id": "RIGHTS.LEAKED_CONFIDENTIAL_MATERIAL", "label": "Leaked or confidential material trigger is classified" },
        { "id": "RIGHTS.COPYRIGHT_SENSITIVE_USE", "label": "Copyright-sensitive source use is classified" },
        { "id": "RIGHTS.COUNSEL_HOLD_BOUNDARY", "label": "Human counsel hold remains outside Gate One signatures" }
      ]
    },
    {
      "id": "LIFECYCLE_READINESS_V1",
      "version": "1.0.0",
      "state": "ENFORCE",
      "owner": "Trust Platform",
      "failureBehavior": "FAIL_CLOSED",
      "summary": "Confirms corrections, retractions, disclosures, appeals, versions, expiry, translations, propagation, and cache invalidation can work after publication.",
      "checks": [
        { "id": "LIFE.CLAIM_LEDGER_ADDRESSABLE", "label": "Material claims are addressable" },
        { "id": "LIFE.VERSION_CHAIN_PRESENT", "label": "Version and parent packet chain are present" },
        { "id": "LIFE.CORRECTION_TAXONOMY", "label": "Correction and retraction taxonomy exists" },
        { "id": "LIFE.CHALLENGE_ENTRYPOINT", "label": "Challenge and appeal route is configured" },
        { "id": "LIFE.PROPAGATION_TARGETS", "label": "Correction propagation targets are known" },
        { "id": "LIFE.PUBLIC_LINEAGE_RENDERABLE", "label": "Public lineage and state history can render" },
        { "id": "LIFE.CACHE_INVALIDATION", "label": "Cache and feed invalidation dependencies are known" }
      ]
    }
  ],
