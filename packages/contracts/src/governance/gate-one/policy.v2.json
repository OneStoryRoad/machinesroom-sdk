      "checks": [
        { "id": "FAIRNESS.AFFECTED_STAKEHOLDERS", "label": "Affected stakeholders are identified" },
        { "id": "FAIRNESS.RIGHT_OF_REPLY_REQUIRED", "label": "Reply applicability is policy-routed" },
        { "id": "FAIRNESS.RIGHT_OF_REPLY_ATTEMPTED", "label": "Required reply attempt is documented" },
        { "id": "FAIRNESS.RESPONSE_ACCURATELY_INCLUDED", "label": "Responses are accurately represented" },
        { "id": "FAIRNESS.COUNTEREVIDENCE", "label": "Counterevidence receives due treatment" },
