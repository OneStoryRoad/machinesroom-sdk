{
  "policyId": "gate-one-v2-mvp",
  "version": "2.2.0",
  "blueprint": {
    "id": "machinesroom-gate-one-v2",
    "version": "1.0.0",
    "decisionDate": "2026-06-24"
  },
  "constitutionDigest": "sha256:af20a5b68b6433aa9740aaea39fc6c8c1d7b9b004f51af8f5daf2476b8ccd47a",
  "invariants": [
    {
      "id": "INV-001",
      "rule": "publication_is_fail_closed",
      "expression": "PacketIsCurrent && AllRequiredPreflightsSatisfied && AllRequiredUniversalLanesSatisfied && AllRequiredSpecialistsSatisfied && AllRequiredDisclosuresRendered && IndependencePolicySatisfied && ConsensusWeightPolicySatisfied && SafetyGateDecision==ALLOW && NoActiveLegalHold && NoActiveAdministrativeKillSwitch"
    },
    {
      "id": "INV-002",
      "rule": "gate_one_is_bot_only_prepublication"
    },
    {
      "id": "INV-003",
      "rule": "gate_two_is_human_only_postpublication"
    },
    {
      "id": "INV-004",
      "rule": "governance_writes_are_signed_replay_protected_and_hash_bound"
    },
    {
      "id": "INV-005",
      "rule": "material_packet_mutation_invalidates_all_gate_one_results"
    },
    {
      "id": "INV-006",
      "rule": "required_control_missing_or_unknown_never_counts_as_pass"
    },
    {
      "id": "INV-007",
      "rule": "safety_gate_remains_separate"
    },
    {
      "id": "INV-008",
      "rule": "legal_rights_is_conditional_not_universal"
    },
    {
      "id": "INV-009",
      "rule": "gate_one_v2_remains_off_chain"
    }
  ],
  "activation": {
    "globalState": "ENFORCE",
    "canaryPercent": 100,
    "componentStates": {
      "PACKET_INTEGRITY_V1": "ENFORCE",
      "PUBLICATION_QA_V1": "ENFORCE",
      "RIGHTS_ROUTING_V1": "ENFORCE",
      "LIFECYCLE_READINESS_V1": "ENFORCE",
      "WRITER": "ENFORCE",
      "FACT_CHECK": "ENFORCE",
      "RISK": "ENFORCE",
      "SOURCE_DIVERSITY": "ENFORCE",
      "FAIRNESS_REPLY": "ENFORCE",
      "PROVENANCE_AUTH": "ENFORCE",
      "EDITORIAL_INTEGRITY": "SHADOW",
      "SPECIALIST_ROUTING": "ENFORCE",
      "INDEPENDENCE": "ENFORCE",
      "DISCLOSURE_RECEIPTS": "ENFORCE",
      "PUBLIC_RECEIPTS": "ENFORCE",
      "CONSENSUS_V2": "ENFORCE"
    }
  },
  "universalLanes": [
    {
      "id": "WRITER",
      "label": "Writer",
      "universal": true,
      "state": "ENFORCE",
      "rubricVersion": "WRITER_RUBRIC_V1",
      "owner": "Editorial Bot Governance",
      "summary": "Assembles a coherent, supportable packet with declared method, materiality, claims, and disclosures.",
      "requiredCheckIds": [
        "WRITER.CLAIMS_DECLARED",
        "WRITER.MATERIALITY_ASSIGNED",
        "WRITER.ARTICLE_TYPE_CORRECT",
        "WRITER.METHOD_DECLARED",
        "WRITER.CLAIM_BLOCK_LINKS_VALID",
        "WRITER.KNOWN_UNKNOWNS_DECLARED",
        "WRITER.DISCLOSURES_DECLARED",
        "WRITER.NO_UNSUPPORTED_ASSERTION_KNOWN"
      ],
      "checks": [
        { "id": "WRITER.CLAIMS_DECLARED", "label": "Material claims declared" },
        { "id": "WRITER.MATERIALITY_ASSIGNED", "label": "Materiality assigned" },
        { "id": "WRITER.ARTICLE_TYPE_CORRECT", "label": "Article type is correct" },
        { "id": "WRITER.METHOD_DECLARED", "label": "Method declared" },
        { "id": "WRITER.CLAIM_BLOCK_LINKS_VALID", "label": "Claim and article block links resolve" },
        { "id": "WRITER.KNOWN_UNKNOWNS_DECLARED", "label": "Known unknowns declared" },
        { "id": "WRITER.DISCLOSURES_DECLARED", "label": "Initial disclosures declared" },
        { "id": "WRITER.NO_UNSUPPORTED_ASSERTION_KNOWN", "label": "No known unsupported assertion" }
      ]
    },
    {
      "id": "FACT_CHECK",
      "label": "Fact Check",
      "universal": true,
      "state": "ENFORCE",
      "rubricVersion": "FACT_CHECK_RUBRIC_V1",
      "owner": "Editorial Bot Governance",
      "summary": "Evaluates every material claim against evidence at the strength and certainty stated.",
      "requiredCheckIds": [
        "FACT.CLAIM_SUPPORT",
        "FACT.CLAIM_STRENGTH_MATCH",
        "FACT.ATTRIBUTION",
        "FACT.QUOTE_CONTEXT_BASIC",
        "FACT.NAMES_DATES_NUMBERS",
        "FACT.CALCULATION_REPRODUCIBLE",
        "FACT.CONTRADICTIONS_DISCLOSED",
        "FACT.EPISTEMIC_STATUS",
        "FACT.TEMPORAL_VALIDITY",
        "FACT.ARTICLE_LEDGER_PARITY"
      ],
      "checks": [
        { "id": "FACT.CLAIM_SUPPORT", "label": "Claims supported by evidence" },
        { "id": "FACT.CLAIM_STRENGTH_MATCH", "label": "Claim strength matches evidence" },
        { "id": "FACT.ATTRIBUTION", "label": "Attribution is correct" },
        { "id": "FACT.QUOTE_CONTEXT_BASIC", "label": "Quote context is sufficient" },
        { "id": "FACT.NAMES_DATES_NUMBERS", "label": "Names, dates, and numbers check out" },
        { "id": "FACT.CALCULATION_REPRODUCIBLE", "label": "Calculations are reproducible" },
        { "id": "FACT.CONTRADICTIONS_DISCLOSED", "label": "Contradictions are disclosed" },
        { "id": "FACT.EPISTEMIC_STATUS", "label": "Epistemic status is accurate" },
        { "id": "FACT.TEMPORAL_VALIDITY", "label": "Temporal validity is addressed" },
        { "id": "FACT.ARTICLE_LEDGER_PARITY", "label": "Article and claim ledger align" }
      ]
    },
    {
      "id": "RISK",
      "label": "Risk",
      "universal": true,
      "state": "ENFORCE",
      "rubricVersion": "RISK_RUBRIC_V1",
      "owner": "Editorial Bot Governance",
      "summary": "Assesses ethical proportionality, privacy, source safety, minors, doxxing, and foreseeable harm.",
      "requiredCheckIds": [
        "RISK.PRIVACY",
        "RISK.MINORS_VULNERABLE",
        "RISK.DOXXING_REIDENTIFICATION",
        "RISK.SOURCE_SAFETY",
        "RISK.GRAPHIC_TRAUMA",
        "RISK.HARASSMENT_AMPLIFICATION",
        "RISK.IMPLICATION_OF_GUILT",
        "RISK.PUBLIC_INTEREST_PROPORTIONALITY",
        "RISK.MITIGATIONS_EFFECTIVE"
      ],
      "checks": [
        { "id": "RISK.PRIVACY", "label": "Privacy risk is proportionate" },
        { "id": "RISK.MINORS_VULNERABLE", "label": "Minors and vulnerable people are protected" },
        { "id": "RISK.DOXXING_REIDENTIFICATION", "label": "Doxxing and re-identification risks are controlled" },
        { "id": "RISK.SOURCE_SAFETY", "label": "Source safety risks are controlled" },
        { "id": "RISK.GRAPHIC_TRAUMA", "label": "Graphic or traumatic material is handled safely" },
        { "id": "RISK.HARASSMENT_AMPLIFICATION", "label": "Harassment amplification risk is controlled" },
        { "id": "RISK.IMPLICATION_OF_GUILT", "label": "Unjustified implication of guilt is avoided" },
        { "id": "RISK.PUBLIC_INTEREST_PROPORTIONALITY", "label": "Public interest is proportionate to harm" },
        { "id": "RISK.MITIGATIONS_EFFECTIVE", "label": "Mitigations are effective" }
      ]
    },
    {
      "id": "SOURCE_DIVERSITY",
      "label": "Source Diversity",
      "universal": true,
      "state": "ENFORCE",
      "rubricVersion": "SOURCE_DIVERSITY_RUBRIC_V1",
      "owner": "Editorial Bot Governance",
      "summary": "Evaluates origin clusters, ownership concentration, directness, source classes, and derivative streams.",
      "requiredCheckIds": [
        "DIVERSITY.ORIGIN_CLUSTERS",
        "DIVERSITY.OWNER_CONCENTRATION",
        "DIVERSITY.PRIMARY_DERIVATIVE_BALANCE",
        "DIVERSITY.INSTITUTIONAL_MONOCULTURE",
        "DIVERSITY.LOCALITY_RELEVANCE",
        "DIVERSITY.LANGUAGE_RELEVANCE",
        "DIVERSITY.SOURCE_CLASS_COVERAGE",
        "DIVERSITY.SINGLE_STREAM_DISCLOSURE"
      ],
      "checks": [
        { "id": "DIVERSITY.ORIGIN_CLUSTERS", "label": "Origin clusters are identified" },
        { "id": "DIVERSITY.OWNER_CONCENTRATION", "label": "Owner concentration is assessed" },
        { "id": "DIVERSITY.PRIMARY_DERIVATIVE_BALANCE", "label": "Primary and derivative balance is sufficient" },
        { "id": "DIVERSITY.INSTITUTIONAL_MONOCULTURE", "label": "Institutional monoculture is assessed" },
        { "id": "DIVERSITY.LOCALITY_RELEVANCE", "label": "Locality relevance is assessed" },
        { "id": "DIVERSITY.LANGUAGE_RELEVANCE", "label": "Language relevance is assessed" },
        { "id": "DIVERSITY.SOURCE_CLASS_COVERAGE", "label": "Source class coverage is sufficient" },
        { "id": "DIVERSITY.SINGLE_STREAM_DISCLOSURE", "label": "Single-stream evidence is disclosed when allowed" }
      ]
    },
    {
      "id": "FAIRNESS_REPLY",
      "label": "Fairness and Reply",
      "universal": true,
      "state": "ENFORCE",
      "rubricVersion": "FAIRNESS_REPLY_RUBRIC_V1",
      "owner": "Editorial Bot Governance",
      "summary": "Evaluates right-of-reply, counterevidence, uncertainty, false balance, and fair treatment of affected subjects.",
      "requiredCheckIds": [
        "FAIRNESS.AFFECTED_STAKEHOLDERS",
