        { "id": "FAIRNESS.KNOWN_UNKNOWNS", "label": "Known unknowns are visible" },
        { "id": "FAIRNESS.UNCERTAINTY_DUE_WEIGHT", "label": "Uncertainty has due weight" },
        { "id": "FAIRNESS.FALSE_BALANCE_AVOIDED", "label": "False balance is avoided" },
        { "id": "FAIRNESS.SERIOUS_ALLEGATION_LABELING", "label": "Serious allegations are labeled and bounded" }
      ]
    },
    {
      "id": "PROVENANCE_AUTH",
